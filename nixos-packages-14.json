            "url": "https://github.com/NixOS/nixpkgs/pull/546066",
            "title": "polkit: add ConsoleKit backend",
            "date_modified": "2026-07-28T03:50:19.000Z",
            "date_published": "2026-07-26T21:14:10.000Z",
            "author": {
