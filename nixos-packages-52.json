    "title": "NixOS Package PRs for plasma-systemmonitor, networkmanager-1.42.6, ark, cups-pk-helper, clion-with-plugins, xrdb packages",
    "home_page_url": "https://pbek.github.io/github-search-rss/nixos-packages-52.json",
