    "title": "NixOS Package PRs for knotifyconfig, kdepim-runtime, ffmpegthumbs, libressl-3.7.2, cryptsetup-2.6.1, gnupg packages",
    "home_page_url": "https://pbek.github.io/github-search-rss/nixos-packages-12.json",
