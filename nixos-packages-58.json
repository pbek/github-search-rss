s\">]</span><span class=\"pl-kos\">)</span> <span class=\"pl-s1\">done</span><span class=\"pl-kos\">)</span>\n      <span class=\"pl-c\"># &amp;&amp; !v.meta.unfree</span>\n      <span class=\"pl-c\"># &amp;&amp; !v.meta.broken</span>\n      <span class=\"pl-c\"># &amp;&amp; !v.meta.unsupported</span>\n      <span class=\"pl-c\"># &amp;&amp; !lib.hasPrefix \"font\" n</span>\n      <span class=\"pl-c\"># &amp;&amp; !lib.hasPrefix \"xf86\" n</span>\n    <span class=\"pl-kos\">)</span><span class=\"pl-kos\">;</span>\n\n  <span class=\"pl-c1\"><span class=\"pl-s1\">pnames</span></span> <span class=\"pl-kos\">=</span> <span class=\"pl-s1\">lib</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\"><span class=\"pl-s1\">mapAttrsToList</span></span> <span class=\"pl-kos\">(</span><span class=\"pl-s1\">_</span>: <span class=\"pl-s1\">v</span>: <span class=\"pl-s1\">v</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\"><span class=\"pl-s1\">pname</span></span><span class=\"pl-kos\">)</span> <span class=\"pl-s1\">pkgs</span><span class=\"pl-kos\">;</span>\n<span class=\"pl-k\">in</span>\n<span class=\"pl-s1\">pkgs</span>\n<span class=\"pl-c\"># get deps</span>\n|<span class=\"pl-c1\">&gt;</span> <span class=\"pl-s1\">lib</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\"><span class=\"pl-s1\">mapAttrs</span></span> <span class=\"pl-kos\">(</span>\n  <span class=\"pl-s1\">_</span>: <span class=\"pl-s1\">v</span>:\n  <span class=\"pl-s1\">v</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\"><span class=\"pl-s1\">buildInputs</span></span> <span class=\"pl-c1\">++</span> <span class=\"pl-s1\">v</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\"><span class=\"pl-s1\">nativeBuildInputs</span></span> <span class=\"pl-c1\">++</span> <span class=\"pl-s1\">v</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\"><span class=\"pl-s1\">propagatedBuildInputs</span></span> <span class=\"pl-c1\">++</span> <span class=\"pl-s1\">v</span><span class=\"pl-